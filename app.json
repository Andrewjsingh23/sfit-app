{
  "expo": {
    "name": "FitForge",
    "slug": "fitforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1120"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.fitforge",
      "infoPlist": {
        "NSCameraUsageDescription": "Used if you add progress photos.",
        "NSPhotoLibraryUsageDescription": "Used to save/select progress photos.",
        "NSHealthShareUsageDescription": "Used to read step and workout data to personalize your plan.",
        "NSHealthUpdateUsageDescription": "Used to write completed workouts to Apple Health."
      }
    },
    "android": {
      "package": "com.yourcompany.fitforge",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1120"
      },
      "permissions": ["ACTIVITY_RECOGNITION"]
    }
  }
}
